{
  appId: 'com.forest.fire.control',
  productName: '林业防火值班室综合管理系统',
  directories: {
    output: 'release/${version}'
  },
  files: [
    'dist',
    'dist-electron'
  ],
  win: {
    target: [
      {
        target: 'nsis',
        arch: ['x64']
      }
    ],
    icon: 'public/icon.png'
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: '林业防火值班室系统'
  }
}
